# Production environment for the triage backend — copy to /etc/triage.env.
# Generated 2026-06-01. Contains no secrets (Zotero creds come from GCP).

# No Cloudflare Access any more: Caddy serves the app only to Tailscale
# addresses (triage.home.jimbarrett.dev), so the tailnet is the access control.
TRIAGE_REQUIRE_CF_ACCESS=false

# No TRIAGE_ALLOWED_ORIGINS: Caddy serves the UI and the API from one origin,
# so CORS stays off.

# Bind localhost only; Caddy on the same host is the sole ingress.
TRIAGE_HOST=127.0.0.1
TRIAGE_PORT=8077

# Obsidian: write stubs into the real vault (synced via obsidian-sync).
TRIAGE_OBSIDIAN_VAULT=/mnt/storage/data/obsidian
TRIAGE_OBSIDIAN_INBOX_SUBDIR=Papers

# Zotero: push `deep` papers. User ID + API key fetched from GCP Secret Manager
# (ZOTERO_USER_ID / ZOTERO_API_KEY); needs jim's gcloud ADC, exposed via HOME.
TRIAGE_ZOTERO_ENABLED=true
