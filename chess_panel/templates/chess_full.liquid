        <symbol id="b-p" viewBox="0 0 45 45"><g><path d="M22.5 9c-2.21 0-4 1.79-4 4 0 .89.29 1.71.78 2.38C17.33 16.5 16 18.59 16 21c0 2.03.94 3.84 2.41 5.03-3 1.06-7.41 5.55-7.41 13.47h23c0-7.92-4.41-12.41-7.41-13.47 1.47-1.19 2.41-3 2.41-5.03 0-2.41-1.33-4.5-3.28-5.62.49-.67.78-1.49.78-2.38 0-2.21-1.79-4-4-4z" fill="#000" stroke="#000" stroke-width="1.5" stroke-linecap="round"/></g></symbol>
        <symbol id="b-q" viewBox="0 0 45 45"><g fill="#000" fill-rule="evenodd" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g fill="#000" stroke="none"><circle cx="6" cy="12" r="2.75"/><circle cx="14" cy="9" r="2.75"/><circle cx="22.5" cy="8" r="2.75"/><circle cx="31" cy="9" r="2.75"/><circle cx="39" cy="12" r="2.75"/></g><path d="M9 26c8.5-1.5 21-1.5 27 0l2.5-12.5L31 25l-.3-14.1-5.2 13.6-3-14.5-3 14.5-5.2-13.6L14 25 6.5 13.5 9 26zM9 26c0 2 1.5 2 2.5 4 1 1.5 1 1 .5 3.5-1.5 1-1.5 2.5-1.5 2.5-1.5 1.5.5 2.5.5 2.5 6.5 1 16.5 1 23 0 0 0 1.5-1 0-2.5 0 0 .5-1.5-1-2.5-.5-2.5-.5-2 .5-3.5 1-2 2.5-2 2.5-4-8.5-1.5-18.5-1.5-27 0z" stroke-linecap="butt"/><path d="M11 38.5a35 35 1 0 0 23 0" fill="none" stroke-linecap="butt"/><path d="M11 29a35 35 1 0 1 23 0M12.5 31.5h20M11.5 34.5a35 35 1 0 0 22 0M10.5 37.5a35 35 1 0 0 24 0" fill="none" stroke="#fff"/></g></symbol>
        <symbol id="b-r" viewBox="0 0 45 45"><g fill="#000" fill-rule="evenodd" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 39h27v-3H9v3zM12.5 32l1.5-2.5h17l1.5 2.5h-20zM12 36v-4h21v4H12z" stroke-linecap="butt"/><path d="M14 29.5v-13h17v13H14z" stroke-linecap="butt" stroke-linejoin="miter"/><path d="M14 16.5L11 14h23l-3 2.5H14zM11 14V9h4v2h5V9h5v2h5V9h4v5H11z" stroke-linecap="butt"/><path d="M12 35.5h21M13 31.5h19M14 29.5h17M14 16.5h17M11 14h23" fill="none" stroke="#fff" stroke-width="1" stroke-linejoin="miter"/></g></symbol>
        <symbol id="w-b" viewBox="0 0 45 45"><g fill="none" fill-rule="evenodd" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><g fill="#fff" stroke-linecap="butt"><path d="M9 36c3.39-.97 10.11.43 13.5-2 3.39 2.43 10.11 1.03 13.5 2 0 0 1.65.54 3 2-.68.97-1.65.99-3 .5-3.39-.97-10.11.46-13.5-1-3.39 1.46-10.11.03-13.5 1-1.354.49-2.323.47-3-.5 1.354-1.94 3-2 3-2zM15 32c2.5 2.5 12.5 2.5 15 0 .5-1.5 0-2 0-2 0-2.5-2.5-4-2.5-4 5.5-1.5 6-11.5-5-15.5-11 4-10.5 14-5 15.5 0 0-2.5 1.5-2.5 4 0 0-.5.5 0 2zM25 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 1 1 5 0z"/></g><path d="M17.5 26h10M15 30h15m-7.5-14.5v5M20 18h5" stroke-linejoin="miter"/></g></symbol>
        <symbol id="w-k" viewBox="0 0 45 45"><g fill="none" fill-rule="evenodd" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22.5 11.63V6M20 8h5" stroke-linejoin="miter"/><path d="M22.5 25s4.5-7.5 3-10.5c0 0-1-2.5-3-2.5s-3 2.5-3 2.5c-1.5 3 3 10.5 3 10.5" fill="#fff" stroke-linecap="butt" stroke-linejoin="miter"/><path d="M11.5 37c5.5 3.5 15.5 3.5 21 0v-7s9-4.5 6-10.5c-4-6.5-13.5-3.5-16 4V27v-3.5c-3.5-7.5-13-10.5-16-4-3 6 5 10 5 10V37z" fill="#fff"/><path d="M11.5 30c5.5-3 15.5-3 21 0m-21 3.5c5.5-3 15.5-3 21 0m-21 3.5c5.5-3 15.5-3 21 0"/></g></symbol>
        <symbol id="w-n" viewBox="0 0 45 45"><g fill="none" fill-rule="evenodd" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M 22,10 C 32.5,11 38.5,18 38,39 L 15,39 C 15,30 25,32.5 23,18" style="fill:#ffffff; stroke:#000000;"/><path d="M 24,18 C 24.38,20.91 18.45,25.37 16,27 C 13,29 13.18,31.34 11,31 C 9.958,30.06 12.41,27.96 11,28 C 10,28 11.19,29.23 10,30 C 9,30 5.997,31 6,26 C 6,24 12,14 12,14 C 12,14 13.89,12.1 14,10.5 C 13.27,9.506 13.5,8.5 13.5,7.5 C 14.5,6.5 16.5,10 16.5,10 L 18.5,10 C 18.5,10 19.28,8.008 21,7 C 22,7 22,10 22,10" style="fill:#ffffff; stroke:#000000;"/><path d="M 9.5 25.5 A 0.5 0.5 0 1 1 8.5,25.5 A 0.5 0.5 0 1 1 9.5 25.5 z" style="fill:#000000; stroke:#000000;"/><path d="M 15 15.5 A 0.5 1.5 0 1 1 14,15.5 A 0.5 1.5 0 1 1 15 15.5 z" transform="matrix(0.866,0.5,-0.5,0.866,9.693,-5.173)" style="fill:#000000; stroke:#000000;"/></g></symbol>
        <symbol id="w-p" viewBox="0 0 45 45"><g><path d="M22.5 9c-2.21 0-4 1.79-4 4 0 .89.29 1.71.78 2.38C17.33 16.5 16 18.59 16 21c0 2.03.94 3.84 2.41 5.03-3 1.06-7.41 5.55-7.41 13.47h23c0-7.92-4.41-12.41-7.41-13.47 1.47-1.19 2.41-3 2.41-5.03 0-2.41-1.33-4.5-3.28-5.62.49-.67.78-1.49.78-2.38 0-2.21-1.79-4-4-4z" fill="#fff" stroke="#000" stroke-width="1.5" stroke-linecap="round"/></g></symbol>
        <symbol id="w-q" viewBox="0 0 45 45"><g fill="#fff" fill-rule="evenodd" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 12a2 2 0 1 1-4 0 2 2 0 1 1 4 0zM24.5 7.5a2 2 0 1 1-4 0 2 2 0 1 1 4 0zM41 12a2 2 0 1 1-4 0 2 2 0 1 1 4 0zM16 8.5a2 2 0 1 1-4 0 2 2 0 1 1 4 0zM33 9a2 2 0 1 1-4 0 2 2 0 1 1 4 0z"/><path d="M9 26c8.5-1.5 21-1.5 27 0l2-12-7 11V11l-5.5 13.5-3-15-3 15-5.5-14V25L7 14l2 12zM9 26c0 2 1.5 2 2.5 4 1 1.5 1 1 .5 3.5-1.5 1-1.5 2.5-1.5 2.5-1.5 1.5.5 2.5.5 2.5 6.5 1 16.5 1 23 0 0 0 1.5-1 0-2.5 0 0 .5-1.5-1-2.5-.5-2.5-.5-2 .5-3.5 1-2 2.5-2 2.5-4-8.5-1.5-18.5-1.5-27 0z" stroke-linecap="butt"/><path d="M11.5 30c3.5-1 18.5-1 22 0M12 33.5c6-1 15-1 21 0" fill="none"/></g></symbol>
        <symbol id="w-r" viewBox="0 0 45 45"><g fill="#fff" fill-rule="evenodd" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 39h27v-3H9v3zM12 36v-4h21v4H12zM11 14V9h4v2h5V9h5v2h5V9h4v5" stroke-linecap="butt"/><path d="M34 14l-3 3H14l-3-3"/><path d="M31 17v12.5H14V17" stroke-linecap="butt" stroke-linejoin="miter"/><path d="M31 29.5l1.5 2.5h-20l1.5-2.5"/><path d="M11 14h23" fill="none" stroke-linejoin="miter"/></g></symbol>
      </defs>

      {% for i in (0..63) %}
        {% assign row = i | divided_by: 8 %}
        {% assign col = i | modulo: 8 %}
        {% assign x = col | times: 54 | plus: 36 %}
        {% assign y = row | times: 54 | plus: 12 %}
        {% assign parity = row | plus: col | modulo: 2 %}
        {% if parity == 1 %}<rect x="{{ x }}" y="{{ y }}" width="54" height="54" fill="url(#dark)"></rect>{% endif %}
      {% endfor %}

      {% if last_from >= 0 %}
        {% for sq in (0..63) %}
          {% if sq == last_from or sq == last_to %}
            {% assign row = sq | divided_by: 8 %}
            {% assign col = sq | modulo: 8 %}
            {% assign x = col | times: 54 | plus: 39 %}
            {% assign y = row | times: 54 | plus: 15 %}
            <rect x="{{ x }}" y="{{ y }}" width="48" height="48" fill="#ffffff" stroke="#000000" stroke-width="5"></rect>
          {% endif %}
        {% endfor %}
      {% endif %}

      {% for i in (0..63) %}
        {% assign p = squares | slice: i %}
        {% if p != "" and p != "." %}
          {% assign row = i | divided_by: 8 %}
          {% assign col = i | modulo: 8 %}
          {% assign x = col | times: 54 | plus: 36 %}
          {% assign y = row | times: 54 | plus: 12 %}
          {% assign kind = p | downcase %}
          {% if p == kind %}{% assign side = "b" %}{% else %}{% assign side = "w" %}{% endif %}
          <use href="#{{ side }}-{{ kind }}" x="{{ x }}" y="{{ y }}" width="54" height="54"></use>
        {% endif %}
      {% endfor %}

      <rect x="34.5" y="10.5" width="435" height="435" fill="none" stroke="#000000" stroke-width="3"></rect>

      <g font-family="'IBM Plex Mono', ui-monospace, monospace" font-size="15" font-weight="600" text-anchor="middle">
        {% for r in (0..7) %}
          {% assign ty = r | times: 54 | plus: 44 %}
          <text x="18" y="{{ ty }}">{{ ranks | slice: r }}</text>
        {% endfor %}
        {% for f in (0..7) %}
          {% assign tx = f | times: 54 | plus: 63 %}
          <text x="{{ tx }}" y="467">{{ files | slice: f }}</text>
        {% endfor %}
      </g>
    </svg>

    <div style="flex-grow: 1; box-sizing: border-box; border-left: 3px solid #000000; display: flex; flex-direction: column;">
      <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 18px; background: #000000; color: #ffffff; font-size: 14px; font-weight: 600; letter-spacing: 2px;">
        <span>CHESS &middot; DAILY</span>
        <span>UPDATED {{ updated }}</span>
      </div>

      {% if has_game %}
        <div style="padding: 18px 18px 14px; border-bottom: 3px solid #000000; display: flex; flex-direction: column; gap: 6px;">
          <span style="font-family: 'Barlow Condensed', 'IBM Plex Mono', sans-serif; font-weight: 800; font-size: 72px; line-height: 0.85;">{% if your_move %}YOUR<br>MOVE{% else %}THEIR<br>MOVE{% endif %}</span>
          <span style="font-size: 14px; font-weight: 600; letter-spacing: 1px;">{% if your_move %}{{ opponent | upcase }} IS WAITING{% else %}WAITING ON {{ opponent | upcase }}{% endif %}</span>
        </div>

        <div style="padding: 12px 18px; display: flex; flex-direction: column; gap: 10px; flex-grow: 1;">
          <div style="display: flex; align-items: baseline; justify-content: space-between; border-bottom: 2px solid #000000; padding-bottom: 4px;">
            <span style="font-size: 13px; font-weight: 600; letter-spacing: 1px;">LAST MOVE</span>
            <span style="font-family: 'Barlow Condensed', 'IBM Plex Mono', sans-serif; font-weight: 800; font-size: 34px; line-height: 1;">{% if last_move != "" %}{{ last_move }}{% else %}&mdash;{% endif %}</span>
          </div>
          <div style="display: flex; align-items: baseline; justify-content: space-between; border-bottom: 2px solid #000000; padding-bottom: 4px;">
            <span style="font-size: 13px; font-weight: 600; letter-spacing: 1px;">TO MOVE BY</span>
            <span style="font-family: 'Barlow Condensed', 'IBM Plex Mono', sans-serif; font-weight: 800; font-size: 34px; line-height: 1;">{% if deadline_at != "" %}{{ deadline_at }}{% else %}&mdash;{% endif %}</span>
          </div>
          <div style="display: flex; align-items: baseline; justify-content: space-between;">
            <span style="font-size: 13px; font-weight: 600; letter-spacing: 1px;">TIME LEFT</span>
            <span style="font-family: 'Barlow Condensed', 'IBM Plex Mono', sans-serif; font-weight: 800; font-size: 34px; line-height: 1;">{% if deadline != "" %}{{ deadline | remove: " LEFT" }}{% else %}&mdash;{% endif %}</span>
          </div>
        </div>

        <div style="padding: 8px 18px; border-top: 2px solid #000000; display: flex; justify-content: space-between; font-size: 12px; letter-spacing: 1px;">
          <span>YOU PLAY {{ colour }}</span>
          <span>{% if other_games == 1 %}+1 OTHER GAME{% elsif other_games > 1 %}+{{ other_games }} OTHER GAMES{% else %}MOVE {{ move_number }}{% endif %}</span>
        </div>
      {% else %}
        <div style="padding: 24px 18px; display: flex; flex-direction: column; gap: 14px; flex-grow: 1;">
          <span style="font-family: 'Barlow Condensed', 'IBM Plex Mono', sans-serif; font-weight: 800; font-size: 64px; line-height: 0.85;">NO GAME<br>ON</span>
          <span style="font-size: 14px; font-weight: 600; letter-spacing: 1px; line-height: 1.5;">CHALLENGE {{ opponent | upcase }} TO A DAILY GAME ON CHESS.COM</span>
        </div>
      {% endif %}
    </div>
  </div>
</div>
